# MaxMovies Backend - Environment Variables

# GiftedTech API Configuration
# Get your API key from: https://movieapi.giftedtech.co.ke
# The key should be used as a Bearer token in the Authorization header
GIFTED_API_KEY=your_gifted_api_key_here

# Example of a valid key format (this is a placeholder):
# GIFTED_API_KEY=gifted_movieapi_378ry3dq7qdlqdgdqg8ordqg78qd0

# When deploying to Vercel:
# 1. Go to your project settings in Vercel dashboard
# 2. Navigate to "Environment Variables"
# 3. Add GIFTED_API_KEY with your actual API key value
# 4. The key will be injected at runtime for your serverless functions
